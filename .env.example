# 复制为 .env 后按需修改。不要把真实密钥提交到 GitHub。
APP_VECTOR_STORE=milvus
APP_MILVUS_URI=http://milvus-standalone:19530
APP_MILVUS_TOKEN=root:Milvus

# 默认 local 可零密钥演示；接入兼容 OpenAI 的服务时改为 openai。
APP_EMBEDDING_PROVIDER=local
APP_CHAT_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_DIMENSION=384
